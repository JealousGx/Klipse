# Copy to `.env` in this directory for local tooling and for Docker Compose
# (`pnpm processor:docker:up` loads `packages/external-video-processor/.env`).
#
# Required wherever the processor runs (Docker, VPS, Fly, ECS, etc.):
# inject these as real env vars — same mechanism as any other service.
#
# Values must match the main app’s `VIDEO_PROCESSOR_*` secrets (see repo root
# `.env.example`). One shared pair of secrets.
#
# The processor does **not** read `VIDEO_PROCESSOR_URL`. That variable exists
# only on the **app** so it knows the processor’s public base URL to call
# `POST /v1/process`.

VIDEO_PROCESSOR_CLIENT_SECRET=  # app → processor Authorization bearer (openssl rand -hex 32)
VIDEO_PROCESSOR_WEBHOOK_SECRET= # processor → app `/api/internal/video-processor/assembly-complete` bearer (openssl rand -hex 32)

# Optional:
# PORT=8790
# FFMPEG_PATH=                     # if ffmpeg not on PATH
# FFPROBE_PATH=
# GOOGLE_TTS_VOICE_NAME=           # default: en-US-Wavenet-G