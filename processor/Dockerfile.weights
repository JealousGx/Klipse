# syntax=docker/dockerfile:1.6
# Standalone "weights" image — a STAGING artifact, not something the runtime job pulls
# directly. Cloud Run mounts model weights from a GCS bucket at runtime instead of baking
# them into the app image (see processor/Dockerfile and cloudbuild-weights-to-gcs.yaml) —
# that migration script copies files OUT of this image and into the bucket. Built RARELY,
# only when the model version/artifacts actually change (run from inside processor/):
#
#   docker build -f Dockerfile.weights \
#     -t us-central1-docker.pkg.dev/<PROJECT_ID>/klipse/processor-weights:ltx-2.3-distilled-v1 \
#     . --secret id=hf_token,env=HF_TOKEN
#   docker push us-central1-docker.pkg.dev/<PROJECT_ID>/klipse/processor-weights:ltx-2.3-distilled-v1
#
# After rebuilding this (new model version), re-run cloudbuild-weights-to-gcs.yaml to
# refresh the GCS bucket — Cloud Run picks up the new files on the next cold start, no
# app-image rebuild needed.
#
# Requires an HF token with both the Lightricks/LTX-2.3 community license and the Gemma
# license accepted, passed as a build secret (never a build ARG — those get cached into
# image layers/logs): docker build --secret id=hf_token,env=HF_TOKEN ...
#
# Real filenames confirmed against the Lightricks/LTX-2.3 HF repo listing (157GB total
# repo — only the 2 files below are needed for the distilled pipeline, not the full repo):
#   - ltx-2.3-22b-distilled-1.1.safetensors        (46.1GB, standalone distilled checkpoint)
#   - ltx-2.3-spatial-upscaler-x2-1.1.safetensors  (996MB, matches DistilledPipeline's 2x stage)
#   - gemma-3-12b-it-qat-q4_0-unquantized/         (separate repo, Gemma 3-12B text encoder)

FROM python:3.12-slim

WORKDIR /weights
RUN pip install --no-cache-dir huggingface_hub

RUN --mount=type=secret,id=hf_token \
	python -c "\
from huggingface_hub import hf_hub_download, snapshot_download; \
token = open('/run/secrets/hf_token').read().strip(); \
hf_hub_download(repo_id='Lightricks/LTX-2.3', filename='ltx-2.3-22b-distilled-1.1.safetensors', local_dir='/weights', token=token); \
hf_hub_download(repo_id='Lightricks/LTX-2.3', filename='ltx-2.3-spatial-upscaler-x2-1.1.safetensors', local_dir='/weights', token=token); \
snapshot_download(repo_id='Lightricks/gemma-3-12b-it-qat-q4_0-unquantized', local_dir='/weights/gemma-3-12b-it-qat-q4_0-unquantized', token=token)"
