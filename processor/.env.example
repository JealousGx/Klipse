# Static Job-container config (set once on the Cloud Run Job resource / .env for local
# docker-compose testing) — NOT per-execution.

# Main app base URL — used to fetch the full job spec (/api/internal/processor/job-spec)
# and for progress/complete callbacks. Local dev (processor in Docker, app on host):
# http://host.docker.internal:3000
KLIPSE_APP_BASE_URL=

# Shared secret for both the job-spec fetch above and all callbacks — must match
# VIDEO_PROCESSOR_WEBHOOK_SECRET in the main app's env.
VIDEO_PROCESSOR_WEBHOOK_SECRET=

# Per-execution override — set by the main app's Cloud Run Admin API `run` call in
# production. For a local one-off test run, set this yourself to a real video_jobs.id
# from your local DB (see docker-compose.yml's header comment for the run command).
KLIPSE_JOB_ID=

# Deployment label — controls log verbosity (info logs emitted when non-production,
# same gating as the main app's logger). local | development | staging | production
ENVIRONMENT=production

# Set to 1 to enable info-level logs in production (mirrors main app's KLIPSE_PERF_LOG).
KLIPSE_PERF_LOG=

# Direct Axiom HTTP drain (fire-and-forget) — leave blank to disable, logs still print
# to stdout either way (captured by Cloud Run's own logging regardless).
AXIOM_API_TOKEN=
AXIOM_DATASET=klipse
