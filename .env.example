# Copy to `.env.local` (or `.env`) for local development.

# --- Database (required for Drizzle / MySQL) ---
DATABASE_URL="mysql://klipse:klipse@localhost:3306/klipse"

BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET= # Generate a secret key: `npx -y @better-auth/cli secret`

# --- App / server URL ---
# Public origin (Better Auth, OAuth redirects). Local dev:
SERVER_URL=http://localhost:3000
# YouTube WebSub (PubSubHubbub) requires a public HTTPS URL for hub.callback in production.
# Optional overrides:
# YOUTUBE_PUBSUB_HUB_URL=https://pubsubhubbub.appspot.com/subscribe
# YOUTUBE_PUBSUB_LEASE_SECONDS=604800

# --- Google OAuth (Better Auth social sign-in) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Queue / workers (Cloudflare Worker → Node HTTP bridge) ---
WORKER_API_URL=http://127.0.0.1:8787
WORKER_SECRET=

# --- Cloudflare R2 (clips + profile photos; browser uses presigned PUT — configure bucket CORS for your origin) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=

# --- Polar (Better Auth plugin: checkout, portal, webhooks at /api/auth/polar/webhooks) ---
POLAR_WEBHOOK_SECRET=
POLAR_ACCESS_TOKEN=
POLAR_SERVER=sandbox
POLAR_PRODUCT_BASIC=
POLAR_PRODUCT_PRO=
POLAR_PRODUCT_AGENCY=
POLAR_PRODUCT_CREDITS=
POLAR_CREDITS_BONUS_AMOUNT=

# --- Observability (optional) ---
# JSON perf lines to stdout (`type: klipse.perf`). Off in production unless set.
# KLIPSE_PERF_LOG=1

# --- Client (Vite) ---
# Optional app title / support email for UI and email “from” fallback.
VITE_APP_TITLE=
# Canonical public URL (https://your-domain.com) — SEO, OG URLs, indexing helpers.
VITE_APP_URL=
VITE_APP_SUPPORT_EMAIL=