# Copy to `.env.local` (or `.env`) for local development.

# Optional deployment label (see src/env.ts). `production` in deployed environments.
# ENVIRONMENT=local

# --- Database (required for Drizzle / MySQL) ---
DATABASE_URL="mysql://klipse:klipse@localhost:3306/klipse"

BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET= # Generate a secret key: `npx -y @better-auth/cli secret`

# --- App / server URL ---
# Public origin (Better Auth, OAuth redirects). Local dev:
SERVER_URL=http://localhost:3000
# YouTube WebSub (PubSubHubbub) requires a public HTTPS URL for hub.callback in production.
# Optional overrides:
# YOUTUBE_PUBSUB_HUB_URL=https://pubsubhubbub.appspot.com/subscribe
# YOUTUBE_PUBSUB_LEASE_SECONDS=604800

# --- Google OAuth (Better Auth social sign-in) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Same OAuth client: add authorized redirect URI `https://<host>/api/youtube/oauth/callback`
# and enable **YouTube Data API v3** in Google Cloud Console for Connect YouTube.
# Random secret (32+ chars) to sign OAuth `state` (CSRF) for /api/youtube/oauth/* (openssl rand -hex 32)
YOUTUBE_OAUTH_STATE_SECRET=

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_OAUTH_STATE_SECRET= # openssl rand -hex 32

# --- Cron auth (cron-job.org or CF Cron Triggers) ---
# Required: bearer token for all /api/cron/* endpoints. Generate: openssl rand -hex 32
INTERNAL_CRON_SECRET=

# --- Cloudflare R2 (clips + profile photos; browser uses presigned PUT — configure bucket CORS for your origin) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
VITE_APP_R2_PUBLIC_BASE_URL= # same value as R2_PUBLIC_BASE_URL, exposed to the client bundle

# --- External video processor (Cloud Run Job — see docs/video-processor.md) ---
# App remains source of truth; presigned PUT to R2, processor never touches credentials
# beyond the shared webhook secret below.
# Base URL used in the processor's job-spec fetch + all callbacks. Encoder in Docker
# cannot use localhost here. Typical: http://host.docker.internal:3000 (processor in
# Docker) or http://localhost:3000.
APP_PUBLIC_URL=http://localhost:3000
VIDEO_PROCESSOR_WEBHOOK_SECRET=  # shared bearer for job-spec fetch + all processor callbacks (openssl rand -hex 32)
# Overrides the callback URL ONLY for video-processor dispatch (not TikTok OAuth or
# anything else reading APP_PUBLIC_URL) — for local dev against a real deployed
# processor via a tunnel (ngrok/Cloudflare Tunnel/etc.), e.g.:
# VIDEO_PROCESSOR_CALLBACK_URL=https://<your-tunnel>.trycloudflare.com
VIDEO_PROCESSOR_CALLBACK_URL=

# --- GCP — triggering klipse-processor Cloud Run Job executions ---
GCP_PROJECT_ID=
GCP_RUN_REGION=us-central1
GCP_RUN_JOB_NAME=klipse-processor-job
GCP_SERVICE_ACCOUNT_EMAIL=
GCP_SERVICE_ACCOUNT_PRIVATE_KEY=  # PEM, with literal \n escapes (see gcp-auth.server.ts)

# Comma-separated Google AI Studio keys for Gemini fallback (script), if no `provider_api_keys` rows for `gemini`.
# Model itself is not env-configurable — hardcoded in processor/src/script_gen.py
# (DEFAULT_GEMINI_FALLBACK_MODEL), overridable per-key via the DB `model_id` column.
GEMINI_API_KEYS=

# Comma-separated Google Cloud API keys for Text-to-Speech fallback.
GOOGLE_TTS_API_KEYS=
GOOGLE_TTS_VOICE_NAME=en-US-Wavenet-G

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=

# --- Polar (Better Auth plugin; FEATURE_DOC §10) ---
# Webhook URL in Polar dashboard: `https://<your-domain>/api/auth/polar/webhooks`
POLAR_WEBHOOK_SECRET= # for local: polar listen http://localhost:3000/
POLAR_ACCESS_TOKEN=
POLAR_SERVER=sandbox
# Subscription products → tiers (Starter / Creator / Empire). IDs from Polar dashboard.
POLAR_PRODUCT_STARTER=
POLAR_PRODUCT_CREATOR=
POLAR_PRODUCT_EMPIRE=
# One-time credit packs (FEATURE_DOC §10.4: 1k and 3k credits).
POLAR_PRODUCT_CREDITS=
POLAR_PRODUCT_CREDITS_LARGE=
# Usage billing: one meter — **Name** = `klipse.usage`, **Aggregation** = **Sum** on metadata **credits** (metadata.credits)
# (same integer units as internal credits; see `credit-costs.ts`). Not Count — weighted stages differ.

# --- Observability (optional) ---
# JSON perf lines to stdout (`type: klipse.perf`). Off in production unless set.
# KLIPSE_PERF_LOG=1

# --- Client (Vite) ---
# Optional app title / support email for UI and email “from” fallback.
VITE_APP_TITLE=
# Canonical public URL (https://your-domain.com) — SEO, OG URLs, indexing helpers.
VITE_APP_URL=
VITE_APP_SUPPORT_EMAIL=

# Comma-separated list of emails that should be auto-promoted to admin on login. Only used if the `admin` plugin is enabled.
ADMIN_EMAILS=

VITE_APP_DISCORD_URL=https://discord.gg/qAd2HdSUSC
VITE_APP_FEATURE_BASE_URL=https://klipse.featurebase.app

DISCORD_BUG_REPORT_WEBHOOK_URL=

SENTRY_DSN=ttps://abc123@o123.ingest.sentry.io/456
VITE_APP_SENTRY_DSN=ttps://abc123@o123.ingest.sentry.io/456

SENTRY_AUTH_TOKEN=

# --- Feature flags (see src/env.ts) ---
VITE_REGISTRATION_ENABLED=true
REGISTRATION_ENABLED=true